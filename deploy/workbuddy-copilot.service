[Unit]
Description=WorkBuddy Copilot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=workbuddy-copilot
Group=workbuddy-copilot
WorkingDirectory=/srv/workbuddy-copilot/current
Environment=COPILOT_CONFIG=/etc/workbuddy-copilot/config.json
Environment=COPILOT_HOST=127.0.0.1
Environment=COPILOT_PORT=8765
Environment=COPILOT_PUBLIC=1
Environment=COPILOT_WORKERS=1
Environment=PYTHON_BIN=/srv/workbuddy-copilot/current/venv/bin/python
EnvironmentFile=-/etc/workbuddy-copilot/secrets.env
ExecStartPre=/srv/workbuddy-copilot/current/deploy/preflight.sh
ExecStart=/srv/workbuddy-copilot/current/start_service.sh
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/workbuddy-copilot

[Install]
WantedBy=multi-user.target
